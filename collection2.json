  "item": [
    {
      "name": "CHoisir deux produits",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let nbr_article = Math.floor(Math.random()*4)+2;\r",
              "pm.collectionVariables.set(\"nbr_article\",nbr_article);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let article_Trouvé = 0;\r",
              "let res = pm.response.json();\r",
              "let nb_Articles = res.products.length; \r",
              "let articles = res.products; \r",
              "let articles_achetes = [];\r",
              "let nbr = pm.collectionVariables.get(\"nbr_article\"); \r",
              "\r",
              "while (article_Trouvé < 2) \r",
              "{   \r",
              "    \r",
              "    let article_Random = Math.floor(Math.random() * nb_Articles);\r",
              "    if(articles[article_Random].stock > 0 && !articles_achetes.includes(articles[article_Random]) && articles[article_Random].stock >= nbr )\r",
              "    {\r",
              "        articles_achetes.push(articles[article_Random]);\r",
              "        article_Trouvé++;\r",
              "    }\r",
              "}\r",
              "\r",
              "pm.collectionVariables.set(\"produits_achetes\",articles_achetes);\r",
              "\r",
              "for(let product of articles_achetes)\r",
              "{\r",
              "    console.log(\"name \"+product.name+\" stock \"+product.stock+\" price \"+product.price);\r",
              "}\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Check if nbr produits achetes supp au random\", function () {\r",
              "    for(let product of articles_achetes)\r",
              "    {\r",
              "        pm.expect(product.stock).to.be.greaterThanOrEqual(nbr)\r",
              "\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.efi-academy.com/user-api/public/products",
          "protocol": "https",
          "host": [
            "api",
            "efi-academy",
            "com"
          ],
          "path": [
            "user-api",
            "public",
            "products"
          ]
        }
      },
      "response": []
    },
