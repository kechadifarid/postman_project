    {
      "name": "random char and add users id",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomChar = String.fromCharCode(Math.floor(Math.random() * 26) + 97);\r",
              "pm.collectionVariables.set(\"randomChar\", randomChar);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"add users \", function () {\r",
              "let res = pm.response.json();\r",
              " let users = []\r",
              "    while(users.length<2)\r",
              "    {\r",
              "        let randomEvent = Math.floor(Math.random() * res.data.length);\r",
              "        if(!users.includes(res.data[randomEvent]) && res.data[randomEvent].is_followed===false)\r",
              "            users.push(res.data[randomEvent]);\r",
              "    }\r",
              "\r",
              "    pm.collectionVariables.set(\"user1\", users[0].id);\r",
              "    pm.collectionVariables.set(\"user2\", users[1].id);\r",
              "\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{url}}/v1/users/search?q={{randomChar}}&page=1",
          "host": [
            "{{url}}"
          ],
          "path": [
            "v1",
            "users",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "{{randomChar}}"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
